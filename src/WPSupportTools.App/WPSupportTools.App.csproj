<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WPSupportTools</AssemblyName>
    <RootNamespace>WPSupportTools.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Main próprio (Program.cs): o mesmo .exe roda como interface ou como serviço do Windows. -->
    <StartupObject>WPSupportTools.App.Program</StartupObject>
  </PropertyGroup>

  <!-- Chave pública de atualização, injetada pela compilação no GitHub (-p:UpdatePublicKey=...). -->
  <ItemGroup Condition="'$(UpdatePublicKey)' != ''">
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(UpdatePublicKey)" />
  </ItemGroup>

  <!-- Senha do servidor do TSPrint (token), injetada pela compilação no GitHub a partir do segredo
       WPST_TSPRINT_TOKEN. Fica fora do código; compilações locais saem sem ela. -->
  <ItemGroup Condition="'$(TSPrintToken)' != ''">
    <AssemblyMetadata Include="TSPrintToken" Value="$(TSPrintToken)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WPSupportTools.Core\WPSupportTools.Core.csproj" />
  </ItemGroup>

</Project>
