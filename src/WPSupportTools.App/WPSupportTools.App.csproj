<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WPSupportTools</AssemblyName>
    <RootNamespace>WPSupportTools.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Main próprio (Program.cs): o mesmo .exe roda como interface ou como serviço do Windows. -->
    <StartupObject>WPSupportTools.App.Program</StartupObject>
  </PropertyGroup>

  <!-- Chave pública de atualização, injetada pela compilação no GitHub (-p:UpdatePublicKey=...). -->
  <ItemGroup Condition="'$(UpdatePublicKey)' != ''">
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(UpdatePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WPSupportTools.Core\WPSupportTools.Core.csproj" />
  </ItemGroup>

</Project>
