<Window x:Class="WPSupportTools.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WPSupportTools.App"
        xmlns:vm="clr-namespace:WPSupportTools.App.ViewModels"
        Title="WP Support Tools"
        Width="600" Height="720" MinWidth="520" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <local:ScreenVisibilityConverter x:Key="ScreenVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />

        <!-- Uma linha da lista de etapas -->
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type vm:StepViewModel}">
            <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="Icon" Style="{StaticResource Icon}" FontSize="16"
                           Text="&#xEA3A;" Foreground="{StaticResource SubtleTextBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="14"
                               Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Message" Text="{Binding Message}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                    <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Running}">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE895;" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Spin">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Spin" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Succeeded}">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE73E;" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Simulated}">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE73E;" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Skipped}">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE738;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StepStatus.Failed}">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE711;" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Background="{StaticResource AccentBrush}" Padding="32,26">
            <StackPanel>
                <TextBlock Text="WP Support Tools" FontSize="26" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Ferramentas de suporte técnico" FontSize="14" Foreground="#D6E4F3" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="32,28">

            <!-- ======================= Tela inicial ======================= -->
            <StackPanel VerticalAlignment="Center"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Home}">
                <ItemsControl ItemsSource="{Binding Actions}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,24">
                                <Button Style="{StaticResource HeroButton}"
                                        Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding IconGlyph}" FontSize="26" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Body}" Text="{Binding Description}"
                                           TextAlignment="Center" Margin="12,16,12,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ============ Execução / Concluído / Falha ============ -->
            <Grid Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisibility}, ConverterParameter='Running,Completed,Failed'}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Em andamento -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Running}">
                    <TextBlock Style="{StaticResource Heading}" Text="{Binding RunTitle}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="Aguarde. Não desligue o computador nem feche esta janela." />
                </StackPanel>

                <!-- Concluído -->
                <Border Style="{StaticResource Card}" Background="{StaticResource SuccessSoftBrush}" BorderBrush="Transparent"
                        Margin="0,0,0,16"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Completed}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE930;" FontSize="30"
                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Top" Margin="0,2,16,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="Correção concluída" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                       Text="Os procedimentos de manutenção foram executados." />
                            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Text="Tente imprimir novamente." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Falha -->
                <Border Style="{StaticResource Card}" Background="{StaticResource DangerSoftBrush}" BorderBrush="Transparent"
                        Margin="0,0,0,16"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Failed}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEA39;" FontSize="30"
                                   Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,16,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="{Binding FailureTitle}" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="{Binding FailureMessage}" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Text="Entre em contato com o suporte de TI." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Aviso de modo de simulação -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,16"
                        Background="{StaticResource WarningSoftBrush}" BorderBrush="Transparent"
                        Visibility="{Binding IsSimulation, Converter={StaticResource BoolVisibility}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="16"
                                   Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                   Text="Modo de demonstração: os comandos reais ainda não foram configurados. Nenhuma alteração foi feita neste computador." />
                    </DockPanel>
                </Border>

                <!-- Lista de etapas -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}" Focusable="False" />
                    </ScrollViewer>
                </Border>

                <!-- Botões: concluído -->
                <StackPanel Grid.Row="3" Margin="0,20,0,0"
                            Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Completed}">
                    <Button Style="{StaticResource SuccessButton}" Command="{Binding ResolvedCommand}" Padding="18,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,10,0" />
                            <TextBlock Text="Funcionou" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerOutlineButton}" Command="{Binding NotResolvedCommand}"
                            Padding="18,12" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" Margin="0,0,10,0" />
                            <TextBlock Text="Não funcionou — chamar suporte" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Botões: falha -->
                <StackPanel Grid.Row="3" Margin="0,20,0,0"
                            Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Failed}">
                    <Button Style="{StaticResource SecondaryButton}" Content="Voltar ao início" Command="{Binding BackHomeCommand}" />
                </StackPanel>
            </Grid>

            <!-- ======================= Funcionou ======================= -->
            <StackPanel VerticalAlignment="Center"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Resolved}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE930;" FontSize="56" HorizontalAlignment="Center"
                           Foreground="{StaticResource SuccessBrush}" />
                <TextBlock Style="{StaticResource Heading}" Text="Que bom que funcionou!" TextAlignment="Center" Margin="0,18,0,0" />
                <TextBlock Style="{StaticResource Body}" Text="Atendimento finalizado." TextAlignment="Center" Margin="0,8,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Fechar" Command="{Binding CloseCommand}"
                        Margin="0,32,0,0" Width="220" />
                <Button Style="{StaticResource LinkButton}" Content="Voltar ao início" Command="{Binding BackHomeCommand}"
                        HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <!-- ======================= Não funcionou ======================= -->
            <StackPanel VerticalAlignment="Center"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Escalated}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE95B;" FontSize="52" HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Style="{StaticResource Heading}" TextAlignment="Center" Margin="0,18,0,0"
                           Text="O problema não foi resolvido pelos procedimentos automáticos." />
                <TextBlock Style="{StaticResource Body}" TextAlignment="Center" Margin="0,10,0,0" FontSize="15"
                           Foreground="{StaticResource TextBrush}" Text="Entre em contato com o suporte de TI." />
                <TextBlock Style="{StaticResource Body}" TextAlignment="Center" Margin="0,14,0,0" FontSize="12"
                           Text="Informe ao suporte que a ferramenta automática já foi executada. O registro do que foi feito está na pasta de logs." />
                <Button Style="{StaticResource SecondaryButton}" Content="Abrir pasta de logs" Command="{Binding OpenLogsCommand}"
                        Margin="0,28,0,0" Width="220" />
                <Button Style="{StaticResource LinkButton}" Content="Voltar ao início" Command="{Binding BackHomeCommand}"
                        HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <!-- Rodapé -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,10"
                Background="{StaticResource SurfaceBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Abrir pasta de logs"
                        Command="{Binding OpenLogsCommand}" />
                <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
